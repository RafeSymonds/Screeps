#!/usr/bin/env bash
#
# bin/sim — run the bot headless in a REAL Screeps engine (Node 24, in Docker).
#
# Not a daemon: each command builds the bot, drives the engine to completion, and exits.
# See sim/README.md for the why.
#
# Usage:
#   bin/sim run [TICKS] [--build] [--scenario NAME] [--every N] [--verbose]
#   bin/sim test [-- <mocha args>]   # behavioral regression tests (sim/tests/)
#   bin/sim build                    # (re)build the Docker engine image
#   bin/sim shell                    # drop into the engine container (debugging)
#   bin/sim clean                    # remove the Docker engine image
#
# Examples:
#   bin/sim run                          # 150 ticks, default scenario
#   bin/sim run 400 --every 25           # longer run, sparser state lines
#   bin/sim run --scenario full-base     # mature RCL8 base
#   bin/sim run --scenario under-attack  # base + hostile wave
#   bin/sim test                         # run all behavioral tests
#   bin/sim test -- --grep defense       # only matching tests
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SIM="$ROOT/sim"
IMAGE="screeps-sim"

die() { echo "error: $*" >&2; exit 1; }
command -v docker >/dev/null 2>&1 || die "docker not found on PATH"
docker info >/dev/null 2>&1 || die "docker daemon not running (start Docker Desktop)"

build_image() { echo "[sim] building image $IMAGE (first build compiles isolated-vm; takes a few minutes)…"; docker build -t "$IMAGE" "$SIM"; }
ensure_image() { docker image inspect "$IMAGE" >/dev/null 2>&1 || build_image; }
build_bot() { echo "[sim] building bot bundle (npm run build)…"; ( cd "$ROOT" && npm run build >/dev/null ) || die "bot build failed"; }

# Freeze the freshly built bundle so a concurrent build/deploy cannot disturb it.
snapshot_bot() {
  [[ -f "$ROOT/dist/main.js" ]] || die "dist/main.js missing after build"
  cp "$ROOT/dist/main.js" "$BUNDLE/main.js"
  [[ -f "$ROOT/dist/main.js.map.js" ]] && cp "$ROOT/dist/main.js.map.js" "$BUNDLE/main.js.map.js"
  echo "[sim] bundle snapshot -> $BUNDLE (immune to concurrent builds)"
}

# The bot bundle is SNAPSHOT, not mounted from dist/.
#
# rollup's `clear({targets:["dist"]})` wipes dist/ at the start of every build —
# including `npm run build` and every `./deploy`. Mounting dist/ live meant any
# build started while a run was in flight deleted the bundle out from under it,
# and every remaining suite died with "bot bundle not found". That destroyed three
# separate gate runs before it was diagnosed, and the failures look alarming and
# unrelated to the code under test.
#
# Copying into a run-private directory costs ~1MB and makes a run immune to
# whatever else the repo is doing. BUNDLE is set per invocation and cleaned by the
# same trap that removes the container.
BUNDLE="$(mktemp -d "${TMPDIR:-/tmp}/screeps-sim-bundle.XXXXXX")"

# Bind-mounts shared by run/test so editing the harness/scenarios/tests needs no rebuild.
MOUNTS=(
  -v "$BUNDLE:/bot:ro"
  -v "$SIM/run.js:/sim/run.js:ro"
  -v "$SIM/lib:/sim/lib:ro"
  -v "$SIM/scenarios:/sim/scenarios:ro"
  -v "$SIM/tests:/sim/tests:ro"
  -v "$SIM/tests-full:/sim/tests-full:ro"
)

# `docker run --rm` only removes the container when it stops normally; if the CLIENT
# is killed (Ctrl-C, `timeout`, kill) the container can keep running. So we name the
# container and force-remove it via a trap on any exit/interrupt as a backstop.
CONTAINER=""
cleanup() {
  [[ -n "$CONTAINER" ]] && docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
  [[ -n "${BUNDLE:-}" && -d "$BUNDLE" ]] && rm -rf "$BUNDLE" || true
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM

# Run the engine container in the background and wait, so a trapped signal (Ctrl-C,
# timeout, kill) interrupts the wait and fires cleanup immediately — a foreground
# `docker run` would defer the trap until it returned, leaking a live container.
run_container() { docker run "$@" & wait $!; }

cmd="${1:-run}"; shift || true

case "$cmd" in
  run)
    ticks="${TICKS:-150}"; scenario="${SCENARIO:-default}"; every="${EVERY:-10}"; verbose="${VERBOSE:-0}"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --build)    build_image ;;
        --scenario) scenario="${2:?--scenario needs a name}"; shift ;;
        --every)    every="${2:?--every needs a number}"; shift ;;
        --verbose)  verbose=1 ;;
        --ticks)    ticks="${2:?--ticks needs a number}"; shift ;;
        ''|*[!0-9]*) die "unknown argument: $1" ;;
        *)          ticks="$1" ;;
      esac
      shift
    done
    ensure_image
    build_bot
    snapshot_bot
    echo "[sim] running: scenario=$scenario ticks=$ticks every=$every verbose=$verbose"
    CONTAINER="screeps-sim-run-$$"
    run_container --rm --init --name "$CONTAINER" "${MOUNTS[@]}" \
      -e TICKS="$ticks" -e SCENARIO="$scenario" -e EVERY="$every" -e VERBOSE="$verbose" \
      -e SIM_NEIGHBOR_RADIUS \
      "$IMAGE"
    ;;
  test)
    [[ "${1:-}" == "--" ]] && shift || true
    ensure_image
    build_bot
    snapshot_bot
    echo "[sim] running behavioral tests (real engine, this is slower than npm run test)…"
    CONTAINER="screeps-sim-test-$$"
    # Parallel by FILE: one scenario suite per test file, each runScenario isolates
    # its own server/port/storage (harness derives ports from pid). Wall clock ≈ the
    # slowest single scenario instead of the sum — the suite dropped from ~70 min
    # serial to ~the longest run. SIM_JOBS tunes workers (default 4; SIM_JOBS=1 for
    # serial debugging). Iterate on one suite with `bin/sim test -- --grep <name>`;
    # run the full suite before every milestone commit.
    # Two tiers (sim/README.md): the FAST suite (tests/, staged scenarios, ~2-3 min
    # wall) is the iteration loop; `bin/sim test --full` adds the full-arc suites
    # (tests-full/, ~40 min) and is the pre-milestone-commit gate.
    globs=("tests/**/*.test.js")
    if [[ "${1:-}" == "--full" ]]; then shift; globs+=("tests-full/**/*.test.js"); fi
    [[ "${1:-}" == "--" ]] && shift || true
    jobs="${SIM_JOBS:-4}"
    run_container --rm --init --name "$CONTAINER" "${MOUNTS[@]}" -e SIM_NEIGHBOR_RADIUS --entrypoint npx "$IMAGE" mocha --exit --parallel --jobs "$jobs" "${globs[@]}" "$@"
    ;;
  build|rebuild) build_image ;;
  shell)
    ensure_image
    CONTAINER="screeps-sim-shell-$$"
    docker run --rm -it --init --name "$CONTAINER" -v "$BUNDLE:/bot:ro" -v "$SIM:/sim" --entrypoint bash "$IMAGE"
    ;;
  clean) docker image rm "$IMAGE" 2>/dev/null && echo "[sim] removed $IMAGE" || echo "[sim] no image to remove" ;;
  help|-h|--help) sed -n '2,27p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $cmd (try: run | test | build | shell | clean | help)" ;;
esac
